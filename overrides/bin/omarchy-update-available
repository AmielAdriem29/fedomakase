#!/bin/bash

# omarchy:summary=Print pending updates and exit 0 when there are any (Fedora port: dnf + Flathub)
# omarchy:hidden=true

# Refreshes this user's dnf cache. dnf-makecache.timer only refreshes root's
# cache, which a normal user can't read from, so --cacheonly goes stale. Offline,
# fall back to whatever is cached.
dnf_output=$(dnf check-update --refresh --quiet 2>/dev/null)
(($? == 1)) && dnf_output=$(dnf check-update --cacheonly --quiet 2>/dev/null)
updates=$(awk 'NF == 3 && $1 ~ /\./ { print $1, $2 }' <<<"$dnf_output")

flatpaks=
if command -v flatpak >/dev/null; then
  flatpaks=$(timeout 30 flatpak remote-ls --updates --columns=application 2>/dev/null)
fi

count=$(printf '%s\n%s\n' "$updates" "$flatpaks" | grep -c .)

if ((count > 0)); then
  echo "$count Fedora package and Flatpak update(s) available"
  exit 0
fi

exit 1
